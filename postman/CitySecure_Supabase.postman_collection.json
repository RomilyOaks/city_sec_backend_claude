            "description": "Lista todos los vehículos con posición GPS actualizada en los **últimos 10 minutos**.\n\nIncluye datos del vehículo, personal conductor y operativo/turno activo.\n\n**Permiso RBAC:** `tracking.vehiculos.read`"
          },
          "response": []
        },
        {
          "name": "Vehículos cercanos a novedad",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200, 404 o 422', function () {",
                  "  pm.expect([200, 404, 422]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Retorna vehiculos_cercanos', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.have.property('vehiculos_cercanos');",
                  "    const n = json.data.vehiculos_cercanos.length;",
                  "    console.log(`Vehículos cercanos a novedad #1: ${n} (máx 5)`);",
                  "  });",
                  "} else if (pm.response.code === 404) {",
                  "  console.warn('Novedad #1 no encontrada — crear novedad primero');",
                  "} else if (pm.response.code === 422) {",
                  "  console.warn('Novedad #1 no tiene coordenadas GPS');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tracking/novedad/1/vehiculos-cercanos",
