# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ============================================
# CONFIGURACIÓN DE VALORES POR DEFECTO
# ============================================
# Código UBIGEO por defecto (Arequipa - Arequipa - Arequipa)
# Formato: DDPPDD donde DD=Departamento, PP=Provincia, DD=Distrito
# Consulta códigos UBIGEO en: https://www.inei.gob.pe/
DEFAULT_UBIGEO_CODE=150108
DEFAULT_UBIGEO_DEPARTMENT=Lima
DEFAULT_UBIGEO_DISTRICT=Chorrillos
DEFAULT_UBIGEO_NAME=Chorrillos
DEFAULT_UBIGEO_PROVINCE=Lima

# ============================================
# CONFIGURACIÓN DE LA BASE DE DATOS
# ============================================
# DB_DIALECT controla el motor activo:
#   mysql    → MySQL en Railway (producción MySQL)
#   postgres → PostgreSQL en Supabase (ver SUPABASE_SETUP.md)
DB_DIALECT=mysql

# DB_SCHEMA solo aplica cuando DB_DIALECT=postgres.
# Para Supabase usar 'citysecure'. Para MySQL este valor se ignora.
DB_SCHEMA=public

# DB_SSL activa SSL en todos los entornos para el dialecto activo.
# Obligatorio para Supabase (DB_SSL=true). Para MySQL local usar false.
DB_SSL=false

# ── MySQL / Railway ───────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=citizen_security_v2
DB_PORT=3306

# ── Supabase (Transaction Pooler — IPv4, requerido para Railway) ─
# ⚠️  Railway no soporta IPv6 — usar SIEMPRE el Transaction Pooler,
#     NO el Direct Connection ni el Session pooler (pueden resolver IPv6).
# Obtener desde: Supabase Dashboard → Settings → Database → Connection parameters
#
# DB_DIALECT=postgres
# DB_SSL=true
# DB_SCHEMA=citysecure
# DB_HOST=aws-1-us-east-1.pooler.supabase.com   # Transaction Pooler host
# DB_PORT=6543                                   # Puerto 6543, NO 5432
# DB_USER=postgres.{tu_project_ref}              # formato: postgres.{project_ref}
# DB_PASSWORD=tu_supabase_db_password            # "Database Password" del dashboard
# DB_NAME=postgres                               # Siempre "postgres" en Supabase


# ============================================
# CONFIGURACIÓN DE JWT
# ============================================
# IMPORTANTE: En producción, usa secrets largos y aleatorios
# Puedes generarlos con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Tiempo de expiración de tokens
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# ============================================
# CONFIGURACIÓN DE CORS
# ============================================
# En desarrollo: * (permite todos los orígenes)
# En producción: especificar el dominio exacto del frontend
CORS_ORIGIN=*

# ============================================
# CONFIGURACIÓN DE SINCRONIZACIÓN DE BASE DE DATOS
# ============================================
# Solo en desarrollo. En producción usar migraciones
SYNC_DB=false


# ============================================
# CONFIGURACIÓN DE BCRYPT
# ============================================
# Rounds para el hash de contraseñas (entre 10-12 es recomendado)
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15m

# ============================================
# CONFIGURACIÓN DE RATE LIMITING (FUTURO)
# ============================================
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CONFIGURACIÓN DE EMAIL (FUTURO)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_email@gmail.com
# SMTP_PASSWORD=tu_password_de_aplicacion
# EMAIL_FROM=noreply@citysec.com
# EMAIL_FROM_NAME=Sistema de Seguridad Ciudadana

# ============================================
# CONFIGURACIÓN DE UPLOADS (FUTURO)
# ============================================
# MAX_FILE_SIZE=5242880
# UPLOAD_PATH=./uploads
# ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# ============================================
# CONFIGURACIÓN DE LOGS (FUTURO)
# ============================================
# LOG_LEVEL=info
# LOG_FILE=logs/app.log

# ============================================
# CONFIGURACIÓN DE SESIONES (FUTURO)
# ============================================
# SESSION_SECRET=tu_session_secret_aqui
# SESSION_MAX_AGE=86400000

# ============================================
# URLS DEL FRONTEND 
# ============================================
# URL pública del frontend (para links en emails — debe ser accesible desde el navegador del usuario)
FRONTEND_PUBLIC_URL=https://citysecfrontendv2-production.up.railway.app
FRONTEND_URL=http://localhost:5173

# PASSWORD_RESET_URL=http://localhost:5173/reset-password
# EMAIL_VERIFY_URL=http://localhost:5173/verify-email
# Frontend URL


# 2FA
TWO_FACTOR_APP_NAME=Seguridad Ciudadana

# OAuth (configurar después si lo usarás)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/v1/auth/microsoft/callback

DEFAULT_COUNTRY=PE
DEFAULT_COUNTRY_NAME=Perú
APP_TIMEZONE=America/Lima

# UBIGEO POR DEFECTO (Santiago de Surco)
#DEFAULT_UBIGEO_CODE=150140
#DEFAULT_UBIGEO_NAME=Santiago de Surco
#DEFAULT_UBIGEO_DEPARTMENT=Lima
#DEFAULT_UBIGEO_PROVINCE=Lima
#DEFAULT_UBIGEO_DISTRICT=Santiago de Surco

DEFAULT_UBIGEO_CODE=150108
DEFAULT_UBIGEO_DEPARTMENT=Lima
DEFAULT_UBIGEO_DISTRICT=Chorrillos
DEFAULT_UBIGEO_NAME=Chorrillos
DEFAULT_UBIGEO_PROVINCE=Lima

# ============================================
# EMAIL — Recuperación de contraseña
# ============================================

# SMTP (Gmail u otro proveedor)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_cuenta@gmail.com
# SMTP_PASSWORD=tu_app_password_de_gmail

# FROM address configurable — sin dominio propio verificado usar onboarding@resend.dev
# Con dominio propio verificado en Resend: noreply@tudominio.com
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=CitySecure

# Resend SDK (alternativa a SMTP — requiere npm install resend)
# RESEND_API_KEY=tu_resend_api_key_aqui

# URL del frontend (usada para el enlace de reset-password)
FRONTEND_URL=http://localhost:5173

# ============================================
# MÓDULO CIUDADANO — SPEC-ABSORCION-ALERT-001
# Supabase Auth, Storage y Voice Gateway
# ============================================

# Supabase Auth — validación de JWT emitidos por Supabase para ciudadanos
# Obtener en: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# URL pública del proyecto Supabase (mismo proyecto que el backend ya usa para BD)
# Obtener en: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://tu_project_ref.supabase.co

# Service Role Key — acceso admin a Supabase Auth y Storage
# ⚠️  NUNCA exponer al frontend ni commitear. Solo uso server-side.
# Obtener en: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Voice Gateway — URL del microservicio que transcribe audio de reportes ciudadanos
# Producción: https://citysecvoicegateway-production.up.railway.app
# Local:      http://localhost:3001
VOICE_GATEWAY_URL=http://localhost:3001

# Timeout en ms para llamadas al Voice Gateway (default: 60 s)
VOICE_GATEWAY_TIMEOUT_MS=60000

# Deep link de la app móvil al que Supabase redirige tras recuperación de contraseña.
# La app intercepta este URL scheme, extrae el access_token y lo envía a
# POST /api/v1/ciudadanos/auth/reset-password
CIUDADANOS_RESET_REDIRECT=citysecure://reset-password

# Tamaño máximo por archivo en subidas de fotos y audio de reportes (en MB)
MAX_FILE_SIZE_MB=5
